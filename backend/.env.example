# SANGRA_AI backend settings. Copy to .env and fill in real values. Never commit .env.
# Every value below is a FAKE placeholder.

# local = the backend runs on your own machine (local paths and "Apply to my folder" allowed)
# deployed = the backend runs on a server
APP_MODE=local

DATABASE_URL=postgresql://sangra:change-me@localhost:5432/sangra_dev

GROQ_API_KEY=gsk_fake_key_replace_me
GROQ_MODEL=openai/gpt-oss-120b

# At least 32 random characters. The app refuses to start with this placeholder.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_LIFETIME_HOURS=24

# Where the frontend runs (used in email links) and which browser origins may call the API (comma separated).
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Absolute folders for the temporary code copies and the download packages (created if missing).
WORKSPACES_DIR=/absolute/path/to/sangra_data/workspaces
PACKAGES_DIR=/absolute/path/to/sangra_data/packages

# Optional (defaults shown)
# HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=INFO
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10
# DB_POOL_TIMEOUT_SECONDS=5
# DOCKER_CHECK_TIMEOUT_SECONDS=2
# MAX_BODY_BYTES=1048576
# MAX_UPLOAD_BYTES=52428800
# Email links: verification link lifetime, reset link lifetime, minimum gap between two verification emails
# VERIFICATION_TOKEN_HOURS=24
# RESET_TOKEN_MINUTES=30
# RESEND_VERIFICATION_MIN_SECONDS=60

# PROJECT_LIMIT=20

# Runs: waiting limit for approval/hint, how often the timeout job runs, live stream check and ping intervals
# WAITING_TIMEOUT_SECONDS=3600
# TIMEOUT_SWEEP_INTERVAL_SECONDS=300
# STREAM_POLL_SECONDS=1
# STREAM_PING_SECONDS=15
# Workspaces: limits for the code copy, clone time limit, age before cleanup
# WORKSPACE_MAX_BYTES=524288000
# WORKSPACE_MAX_FILES=50000
# CLONE_TIMEOUT_SECONDS=300
# WORKSPACE_MAX_AGE_HOURS=24
# Packages and cleanup: days a package is kept, how often the cleanup jobs run, rows per batch, hours an expired
# email token is kept before it is removed
# PACKAGE_EXPIRY_DAYS=7
# CLEANUP_INTERVAL_SECONDS=3600
# CLEANUP_BATCH_SIZE=500
# TOKEN_RETENTION_HOURS=24
# Code tools: files per search, lines per read, file read cap, answer size cap (characters)
# SEARCH_MAX_FILES=20
# READ_MAX_LINES=200
# FILE_READ_CAP_BYTES=1048576
# TOOL_OUTPUT_MAX_CHARS=16000
# Test runner (Docker): images, limits per test run, parallel containers, container user (never root)
# TEST_IMAGE_JAVA=maven:3.9-eclipse-temurin-17
# TEST_IMAGE_PYTHON=python:3.12-slim
# TEST_TIMEOUT_SECONDS=600
# TEST_CPUS=2
# TEST_MEMORY_MB=2048
# TEST_OUTPUT_MAX_BYTES=1048576
# TEST_PIDS_LIMIT=512
# MAX_PARALLEL_TEST_CONTAINERS=2
# TEST_CONTAINER_USER=auto
# TEST_LOG_EXCERPT_CHARS=8000
# LLM: retries (waits 1, 2, 4 s), time limit and reply size per call, tool calls per investigation, context size
# LLM_MAX_RETRIES=3
# LLM_RETRY_BASE_SECONDS=1
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_OUTPUT_TOKENS=8192
# INVESTIGATE_MAX_TOOL_CALLS=15
# LLM_CONTEXT_TOKENS=131072
# Proposal checks: edits and changed lines per attempt, invalid proposals in a row before the run fails
# MAX_EDITS_PER_ATTEMPT=10
# MAX_CHANGED_LINES=300
# MAX_PROPOSAL_CHECKS=3
# Test setups only (refused when APP_MODE=deployed): scripted LLM and test runner, emails written to a file
# AGENT_TEST_MODE=off
# AGENT_FAKE_SCRIPT=/absolute/path/to/fake_script.json
# MAILER_MODE=file
# MAIL_FILE=/absolute/path/to/emails.jsonl
# Agent caps
# MAX_REJECTS=3
# MAX_FAILED_TEST_TRIES=3
# MAX_HINTS=3

# BCRYPT_ROUNDS=12

# Mailer: console prints emails in the terminal (development); smtp sends them; file is for test setups only.
# MAILER_MODE=console
# MAIL_FROM=SANGRA_AI <no-reply@localhost>
# SMTP_HOST=smtp.example.com      (required when MAILER_MODE=smtp)
# SMTP_PORT=587
# SMTP_USERNAME=fake-user
# SMTP_PASSWORD=fake-password
# SMTP_STARTTLS=true

# Rate limits: attempts per window (seconds)
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# RATE_LIMIT_REGISTER=5
# RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
# RATE_LIMIT_FORGOT_PASSWORD=3
# RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=3600
# RATE_LIMIT_RESEND_VERIFICATION=1
# RATE_LIMIT_RESEND_VERIFICATION_WINDOW_SECONDS=60
# RATE_LIMIT_CHANGE_PASSWORD=5
# RATE_LIMIT_CHANGE_PASSWORD_WINDOW_SECONDS=900
