# SANGRA_AI backend settings. Copy to .env and fill in real values. Never commit .env.
# Every value below is a FAKE placeholder.

# local = the backend runs on your own machine (local paths and "Apply to my folder" allowed)
# deployed = the backend runs on a server
APP_MODE=local

DATABASE_URL=postgresql://sangra:change-me@localhost:5432/sangra_dev

GROQ_API_KEY=gsk_fake_key_replace_me
GROQ_MODEL=openai/gpt-oss-120b

# At least 32 random characters. The app refuses to start with this placeholder.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_LIFETIME_HOURS=24

# Where the frontend runs (used in email links) and which browser origins may call the API (comma separated).
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Absolute folders for the temporary code copies and the download packages (created if missing).
WORKSPACES_DIR=/absolute/path/to/sangra_data/workspaces
PACKAGES_DIR=/absolute/path/to/sangra_data/packages

# Optional (defaults shown)
# HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=INFO
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10
# DB_POOL_TIMEOUT_SECONDS=5
# DOCKER_CHECK_TIMEOUT_SECONDS=2
# MAX_BODY_BYTES=1048576
# MAX_UPLOAD_BYTES=52428800
# Email links: verification link lifetime, reset link lifetime, minimum gap between two verification emails
# VERIFICATION_TOKEN_HOURS=24
# RESET_TOKEN_MINUTES=30
# RESEND_VERIFICATION_MIN_SECONDS=60

# PROJECT_LIMIT=20

# BCRYPT_ROUNDS=12

# Mailer: console prints emails in the terminal (development); smtp sends them.
# MAILER_MODE=console
# MAIL_FROM=SANGRA_AI <no-reply@localhost>
# SMTP_HOST=smtp.example.com      (required when MAILER_MODE=smtp)
# SMTP_PORT=587
# SMTP_USERNAME=fake-user
# SMTP_PASSWORD=fake-password
# SMTP_STARTTLS=true

# Rate limits: attempts per window (seconds)
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# RATE_LIMIT_REGISTER=5
# RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
# RATE_LIMIT_FORGOT_PASSWORD=3
# RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=3600
# RATE_LIMIT_RESEND_VERIFICATION=1
# RATE_LIMIT_RESEND_VERIFICATION_WINDOW_SECONDS=60
# RATE_LIMIT_CHANGE_PASSWORD=5
# RATE_LIMIT_CHANGE_PASSWORD_WINDOW_SECONDS=900
